# Production Environment Configuration
# Do not commit real secrets or credentials

# Optional: External ML Inference Service URL (e.g. self-hosted GPU endpoint running ResNet-34 U-Net)
MODEL_API_URL=

# Optional: Authentication Key for External ML Inference Service
MODEL_API_KEY=

# Required for Live AI Assistant: Google Gemini API Key (Server-Side Only)
GEMINI_API_KEY=

# Optional: Gemini Model selection (default: gemini-2.5-flash)
GEMINI_MODEL=

# Optional: Public API URL override (defaults to relative /api)
NEXT_PUBLIC_API_URL=
